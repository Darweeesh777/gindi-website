# Copy this file to .env and fill in real values locally.
# .env is git-ignored. Never commit real secrets. On Render, set these under
# the service's Environment tab instead (see docs/deployment-render.md).

# --- Required in every environment ---
# Generate one with:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key

# --- Production / staging only (config.settings.production) ---
# Select production settings through the real environment (on Render:
# DJANGO_SETTINGS_MODULE=config.settings.production); .env is read too late
# to choose the settings module.
# Comma-separated. On Render, the *.onrender.com hostname is added automatically.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Keep 0 until HTTPS works on the real domain (hard to undo).
DJANGO_SECURE_HSTS_SECONDS=0

# Database: one URL. SQLite (relative to the project root) or PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# (Alternatively POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST, POSTGRES_PORT.)

# Gunicorn processes (2 suits Render's free instance).
WEB_CONCURRENCY=2

# --- Preview vs launch ---
# true: noindex header/meta for search engines (previews). false only at launch.
SITE_NOINDEX=true

# --- Optional admin account, created by build.sh (set on Render, not here) ---
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# --- Integrations (empty = not connected; the site says so honestly) ---
# Enquiry form endpoint (e.g. a form service URL).
ENQUIRY_FORM_ACTION=
# WhatsApp number, international format, digits only (enquiry drawer and
# the quotation form's "Submit via WhatsApp").
WHATSAPP_NUMBER=
# Email address that receives quotation requests ("Submit via Email" opens
# the visitor's email app addressed to it).
QUOTATION_EMAIL=
# The form backend (worker/index.js) and the PUBLIC Turnstile site key. Both
# set: the forms send directly. On Cloudflare, set them as build variables.
# The secrets (Resend API key, Turnstile secret key) are Worker secrets, never here.
CONTACT_API_URL=
TURNSTILE_SITE_KEY=

# --- Local development only (config.settings.development) ---
# DJANGO_DEV_ALLOWED_HOSTS=192.168.1.10
