// Cloudflare Workers (static assets only): serves the static export in dist/,
// built by `bash cloudflare-build.sh`. No Worker code runs; requests to static
// assets are free and unlimited. See docs/deployment-cloudflare.md.
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "gindi-website",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist/",
    // Unknown URLs get the nearest 404.html (ar/404.html under /ar/), status 404.
    "not_found_handling": "404-page",
    // /about -> /about/ (pages are saved as about/index.html).
    "html_handling": "auto-trailing-slash"
  }
}
