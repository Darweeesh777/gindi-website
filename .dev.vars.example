# Local secrets for `npx wrangler dev` (copy to .dev.vars, which git ignores).
# Never commit real keys. On Cloudflare these are Worker secrets instead.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Cloudflare's always-pass TEST secret (pairs with the test site key
# 1x00000000000000000000AA). Use your real secret only on Cloudflare.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The address that receives requests. With Resend's test sender it must be the
# email you signed up to Resend with.
CONTACT_TO_EMAIL=you@gmail.com
